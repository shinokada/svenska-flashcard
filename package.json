{
  "name": "svenska-flashcard",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Svenska - English flashcard",
  "homepage": "https://svenska-flashcard.codewithshin.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/shinokada/svenska-flashcard"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test:e2e": "playwright test",
    "test": "npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "flowbite": "^4.0.2",
    "flowbite-svelte": "^1.33.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "runatics": "^0.3.0",
    "runes-meta-tags": "^0.5.1",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-devtools-json": "^1.1.0"
  },
  "packageManager": "pnpm@11.22.0"
}
